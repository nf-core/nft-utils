nextflow_workflow {

    name "Test excludeLines"
    script "./main.nf"
    workflow "TEST"

    tag "excludeLines"

    test("Should remove lines by number and content") {

        then {
            assert workflow.success
            def input = "$baseDir/tests/excludeLines/input.txt"
            assert excludeLines(input, lines: [2, 4]) == ["header", "result: 42"]
            assert excludeLines(input, ignore: ["run "]) == ["header", "result: 42"]
            assert excludeLines(input, lines: [1], ignore: ["date:"]) == ["result: 42", "run time: 3s"]
        }

    }

    test("Should accept ranges and GStrings") {

        then {
            def input = "$baseDir/tests/excludeLines/input.txt"
            def key = "run"
            assert excludeLines(input, lines: 2..4) == ["header"]
            assert excludeLines(input, ignore: ["${key} "]) == ["header", "result: 42"]
        }

    }

    test("Should reject invalid options") {

        then {
            def input = "$baseDir/tests/excludeLines/input.txt"
            [
                [[line: [2]], "Unknown excludeLines() options: [line]"],
                [[ignore: "run"], "option 'ignore' must be a list of String, File or Path"],
                [[ignore: [42]], "option 'ignore' must be a list of String, File or Path"],
                [[lines: [1, 3..4]], "option 'lines' must be a list of Integer"],
            ].each { options, message ->
                try {
                    excludeLines(options, input)
                    assert false : "excludeLines() should reject ${options}"
                } catch (IllegalArgumentException e) {
                    assert e.message.contains(message)
                }
            }
        }

    }

}
