nextflow_pipeline {

    name "Test getAllFilesFromS3"
    script "./main.nf"
    tag "getAllFilesFromS3"

    // S3 path produced by a previous Nextflow run — no pipeline execution needed.
    // The function lists the bucket contents and snapshots the result so that
    // any unexpected addition or deletion is caught on re-run.
    def path_s3_bucket = "s3://nf-core-awsmegatests/sarek/results-4bd2948f98c5bf7b785c91cf6708fffccab25467/test_full_germline_aws/"

    test("getAllFilesFromS3") {
        then {
            // Only list files under a specific sub-prefix
            def all_files = getAllFilesFromS3(path_s3_bucket, noSignRequest: true, ignore: ['pipeline_info/*.{html,json,txt}'])
            def version   = getAllFilesFromS3(path_s3_bucket, noSignRequest: true, include: ['pipeline_info/**'], ignore: ['pipeline_info/*.{html,json,txt}'])
            def vcf_files = getAllFilesFromS3(path_s3_bucket, noSignRequest: true, include: ['variant_calling/deepvariant/**/*.vcf.gz'], ignore: ['variant_calling/deepvariant/**/*.g.vcf.gz'])

            assert snapshot(
              all_files,
              version.collect { relPath ->
                  path(downloadFromS3("${path_s3_bucket}${relPath}", noSignRequest: true).toString())
              },
              vcf_files.collect { relPath ->
                  def local = downloadFromS3("${path_s3_bucket}${relPath}", noSignRequest: true)
                  "${local.fileName}:variantMD5," + path(local.toString()).vcf.variantsMD5
              }
            ).match()
        }
    }
}
