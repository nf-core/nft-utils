nextflow_process {

    name "Test Process MOOVE"
    script "../main.nf"
    process "MOOVE"

    test("bam - with bamKeys") {
        when {
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file('https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/genomics/sarscov2/illumina/bam/test.paired_end.bam', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(sanitizeOutput(process.out, bamKeys: ["output"])).match()}
            )
        }
    }
}
