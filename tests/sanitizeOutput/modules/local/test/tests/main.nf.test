nextflow_process {

    name "Test sanitizeOutput"
    script "../main.nf"
    process "TEST"
    tag "sanitizeOutput"

    test("Default sanitize output - with unstableKeys") {
        when {
          process {
            """
            input[0] = [id:"test"]
            """
          }
        }
        then {
            assert process.success
            assert snapshot(sanitizeOutput(process.out, unstableKeys:["zip", "folder"])).match()
        }
    }

    test("Default sanitize output - without unstableKeys") {
        when {
          process {
            """
            input[0] = [id:"test"]
            """
          }
        }
        then {
            assert process.success
            assert snapshot(sanitizeOutput(process.out)).match()
        }
    }

    test("Default sanitize output - with ignoreKeys zip + html") {
        when {
          process {
            """
            input[0] = [id:"test"]
            """
          }
        }
        then {
            assert process.success
            assert snapshot(sanitizeOutput(process.out, ignoreKeys:["zip", "html"])).match()
        }
    }

    test("Default sanitize output - with ignorePatterns test1") {
        when {
          process {
            """
            input[0] = [id:"test"]
            """
          }
        }
        then {
            assert process.success
            assert snapshot(sanitizeOutput(process.out, ignorePatterns:["**/test1*"])).match()
        }
    }

    test("Default sanitize output - with unstablePatterns test1") {
        when {
          process {
            """
            input[0] = [id:"test"]
            """
          }
        }
        then {
            assert process.success
            assert snapshot(sanitizeOutput(process.out, unstablePatterns:["**/test1*"])).match()
        }
    }

    test("Default sanitize output - with unstablePatterns fastq_1 inside meta") {

        when {
          process {
            """
            input[0] = [id:"test", fastq:"/path/to/my/fastq_1.gz", to_ignore: "123456"]
            """
          }
        }
        then {
            assert process.success
            assert snapshot(sanitizeOutput(process.out, unstablePatterns:["**/fastq_1*"], ignorePatterns:["123456"])).match()
        }
    }
}
