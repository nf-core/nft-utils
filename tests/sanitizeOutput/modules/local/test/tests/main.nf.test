nextflow_process {

    name "Test sanitizeOutput"
    script "../main.nf"
    process "TEST"
    tag "sanitizeOutput"

    test("Default sanitize output - with unstableKeys") {
        when {
          process {
            """
            input[0] = [id:"test"]
            """
          }
        }
        then {
            assert process.success
            assert snapshot(sanitizeOutput(process.out, unstableKeys:["zip", "folder"])).match()
        }
    }

    test("Default sanitize output - without unstableKeys") {
        when {
          process {
            """
            input[0] = [id:"test"]
            """
          }
        }
        then {
            assert process.success
            assert snapshot(sanitizeOutput(process.out)).match()
        }
    }

    test("Default sanitize output - with ignoreKeys zip + html") {
        when {
          process {
            """
            input[0] = [id:"test"]
            """
          }
        }
        then {
            assert process.success
            assert snapshot(sanitizeOutput(process.out, ignoreKeys:["zip", "html"])).match()
        }
    }

    test("Default sanitize output - with ignorePattern test1") {
        when {
          process {
            """
            input[0] = [id:"test"]
            """
          }
        }
        then {
            assert process.success
            assert snapshot(sanitizeOutput(process.out, ignorePattern:["**/test1*"])).match()
        }
    }

    test("Default sanitize output - with unstablePattern test1") {
        when {
          process {
            """
            input[0] = [id:"test"]
            """
          }
        }
        then {
            assert process.success
            assert snapshot(sanitizeOutput(process.out, unstablePattern:["**/test1*"])).match()
        }
    }

    test("Default sanitize output - with unstablePattern fastq_1 inside meta") {
        tag "test2"
        when {
          process {
            """
            input[0] = [id:"test", fastq:"/path/to/my/fastq_1.gz", to_ignore: "123456"]
            """
          }
        }
        then {
            assert process.success
            assert snapshot(sanitizeOutput(process.out, unstablePattern:["**/fastq_1*"], ignorePattern:["123456"])).match()
        }
    }
}
