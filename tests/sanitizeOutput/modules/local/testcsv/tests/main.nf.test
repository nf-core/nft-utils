nextflow_process {

    name "Test sanitizeOutput"
    script "../main.nf"
    process "TESTCSV"
    tag "sanitizeOutput"
    test("Default sanitize output - with tableMD5Keys") {
        when {
          process {
            """
            input[0] = [id:"test"]
            """
          }
        }
        then {
            assert process.success
            assert snapshot(
              normalizeTable(path(process.out.normalized[0][1])),
              normalizeTable(path(process.out.normalized[0][2]), 4),
              normalizeTable(path(process.out.normalized[0][3]), 2),
              sanitizeOutput(process.out, tableMD5Keys:["normalized"], tableDoubleDigits: 5)
            ).match()
        }
    }
}
